{
  "mutations": {
    "rules": [
      "arithmetic.add-to-subtract",
      "arithmetic.subtract-to-add",
      "arithmetic.multiply-to-divide",
      "arithmetic.divide-to-multiply",
      "comparison.equal-to-not-equal",
      "comparison.not-equal-to-equal",
      "comparison.less-to-less-equal",
      "comparison.less-equal-to-less",
      "comparison.greater-to-greater-equal",
      "comparison.greater-equal-to-greater",
      "comparison.less-to-greater",
      "comparison.greater-to-less",
      "logical.and-to-or",
      "logical.or-to-and",
      "assignment.add-to-subtract",
      "assignment.subtract-to-add",
      "assignment.multiply-to-divide",
      "assignment.divide-to-multiply"
    ],
    "targets": {
      "entrypoints": {
        "sources": ["atlas-rust/src/atlas/*.rs", "atlas-rust/src/atlas/paths/*.rs"],
        "cwd": "atlas-rust",
        "command": ["cargo", "test", "--locked", "--lib", "--test", "cli", "--test", "parity_pipeline", "--test", "reindex"],
        "timeoutSeconds": 300
      },
      "cli-commands": {
        "sources": ["atlas-rust/src/atlas/cli/commands.rs", "atlas-rust/src/atlas/cli/mod.rs", "atlas-rust/src/atlas/cli/options.rs", "atlas-rust/src/atlas/cli/schema.rs", "atlas-rust/src/atlas/cli/integers.rs"],
        "cwd": "atlas-rust",
        "command": ["sh", "-c", "cargo test --locked --lib -- cli::options_tests:: cli::schema:: cli::integers:: && cargo test --locked --test cli --test cli_validation --test cli_numeric --test parity"],
        "timeoutSeconds": 300
      },
      "cli-graph": {
        "sources": ["atlas-rust/src/atlas/cli/graph*.rs"],
        "cwd": "atlas-rust",
        "command": ["cargo", "test", "--locked", "--lib", "--test", "parity_navigation", "--test", "navigation_budget", "--test", "cli_validation"],
        "timeoutSeconds": 300
      },
      "cli-mutations": {
        "sources": ["atlas-rust/src/atlas/cli/mutations.rs", "atlas-rust/src/atlas/cli/mutation_targets.rs", "atlas-rust/src/atlas/cli/mutation_run.rs"],
        "cwd": "atlas-rust",
        "command": ["cargo", "test", "--locked", "--lib", "--test", "mutation_safety", "--test", "parity", "--test", "cli_validation"],
        "timeoutSeconds": 300
      },
      "domain-models": {
        "sources": ["atlas-rust/src/atlas/domain/mod.rs", "atlas-rust/src/atlas/domain/models.rs"],
        "cwd": "atlas-rust",
        "command": ["cargo", "test", "--locked", "--lib", "--test", "metrics", "--test", "parity_pipeline"],
        "timeoutSeconds": 300
      },
      "domain-navigation": {
        "sources": ["atlas-rust/src/atlas/domain/navigation.rs"],
        "cwd": "atlas-rust",
        "command": ["cargo", "test", "--locked", "--lib", "--test", "parity_navigation", "--test", "navigation_budget"],
        "timeoutSeconds": 300
      },
      "domain-repositories": {
        "sources": ["atlas-rust/src/atlas/domain/repositories.rs"],

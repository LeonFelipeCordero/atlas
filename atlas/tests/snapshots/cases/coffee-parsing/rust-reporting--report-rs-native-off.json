    "signature": "pub fn render(names: &[&str]) -> String {\n    let entries: Vec<String> = names.iter()\n        .map(|name| format!(\"{}={}\", name, recipe::portions(name)))\n        .collect();\n    format!(\"coffee:{};total={}\", entries.join(\",\"), total(names))\n}",

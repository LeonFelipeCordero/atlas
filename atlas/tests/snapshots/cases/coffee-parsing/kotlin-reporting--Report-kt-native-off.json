    "signature": "fun render(names: List<String>): String {\n    val entries = names.map { name -> \"$name=${portions(name)}\" }\n    val total = names.sumOf { name -> portions(name) }\n    return \"coffee:${entries.joinToString(\",\")};total=$total\"\n}",
